# Public vars (embedded in the browser bundle). Copy to `.env.local` and adjust.

# Rizzerv gateway base URL including `/gateway` — required for download-source analytics
# (POST …/marketplace/filter-usage/append). Use your LAN IP from the device if testing on a phone.
NEXT_PUBLIC_RIZZERV_GATEWAY_BASE_URL=http://localhost:11003/gateway

# Where footer “Get the app” buttons open after logging the click (optional; sensible defaults in code)
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store
